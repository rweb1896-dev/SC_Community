# Copy these values into Render Environment, not into GitHub.
# Never commit the real Neon password or JWT secret.

PORT=10000

# Convert Neon URLs from:
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
# to the JDBC form Spring Boot expects:
DB_URL=jdbc:postgresql://HOST/DB?sslmode=require
DB_USERNAME=USER
DB_PASSWORD=PASSWORD
DB_POOL_SIZE=2

# Generate a long random value for production.
JWT_SECRET=replace-with-at-least-64-random-characters

# First admin account created on first startup.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-with-strong-password

# Never expose or hard-code OTPs in production. Connect email/SMS delivery before launch.
APP_OTP_CODE=
APP_OTP_EXPOSE_CODE=false

# Do not create public demo data or the known local invite code in production.
BOOTSTRAP_DEFAULT_INVITE_ENABLED=false
BOOTSTRAP_SAMPLE_CONTENT_ENABLED=false

# If frontend and backend are served from this same Docker app, this can be the Render app URL.
# If you later host frontend separately on Vercel, add both origins separated by commas.
CORS_ALLOWED_ORIGINS=https://your-render-service.onrender.com
